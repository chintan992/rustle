<?xml version="1.0" encoding="utf-8"?><!--
   Q1: same policy as backup_rules.xml for API 31+ (see that file).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="books" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="books" />
    </device-transfer>
</data-extraction-rules>
